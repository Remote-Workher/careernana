{
  "manifest_version": 3,
  "name": "Remote Workher — AI Apply, Resume, Skills & LinkedIn",
  "version": "1.2.0",
  "description": "Tailor your resume + cover letter, score your resume vs the JD, analyze your skills gap, and optimize your LinkedIn — on any page. Auto-tracks every application.",
  "permissions": ["activeTab", "storage", "tabs", "scripting", "notifications", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icon.png", "48": "icon.png", "128": "icon.png" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["panel.html", "panel.js", "panel.css", "icon.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
